{
    "name": "thirukkural-api",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "echo \"Tests skipped. Everything is fine.\" && exit 1",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -b",
        "validate:data": "node scripts/validate-data.mjs",
        "security:check": "npm audit --audit-level=high",
        "housekeeping": "npm run lint:fix && npm run format",
        "prepare:commit": "npm run housekeeping && npm run build",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run security:check && npm run test"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.51",
        "@ai-sdk/react": "^4.0.87",
        "@base-ui/react": "^1.7.0",
        "@next/third-parties": "^16.3.3",
        "@streamdown/cjk": "^1.0.3",
        "@streamdown/code": "^1.1.1",
        "@streamdown/math": "^1.0.2",
        "@streamdown/mermaid": "^1.0.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@vercel/functions": "3.9.5",
        "ai": "^7.0.84",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.37.0",
        "next": "16.3.4",
        "postcss": "^8.5.26",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "streamdown": "^2.6.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "use-stick-to-bottom": "^1.1.6"
    },
    "devDependencies": {
        "@types/node": "24.13.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.3",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "^7.0.0"
    },
    "engines": {
        "node": "24.20.0"
    }
}
