{
    "name": "thirukkural-api",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "echo \"Tests skipped. Everything is fine.\" && exit 1",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -b",
        "validate:data": "node scripts/validate-data.mjs",
        "security:check": "npm audit --audit-level=high",
        "housekeeping": "npm run lint:fix && npm run format",
        "prepare:commit": "npm run housekeeping && npm run typecheck && npm run build",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run security:check && npm run test"
    },
    "dependencies": {
        "@ai-sdk/openai": "4.0.73",
        "@ai-sdk/react": "4.0.115",
        "@base-ui/react": "1.8.0",
        "@next/third-parties": "16.3.6",
        "@openrouter/ai-sdk-provider": "3.1.0",
        "@streamdown/cjk": "1.0.3",
        "@streamdown/code": "1.1.1",
        "@streamdown/math": "1.0.2",
        "@streamdown/mermaid": "1.0.2",
        "@tailwindcss/postcss": "4.3.3",
        "@vercel/functions": "3.9.9",
        "ai": "7.0.111",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-react": "1.47.0",
        "next": "16.3.6",
        "postcss": "8.5.28",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "streamdown": "2.6.0",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "4.3.3",
        "use-stick-to-bottom": "1.1.6"
    },
    "devDependencies": {
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.11.0",
        "eslint-config-next": "16.3.6",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.9",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": "24.21.0"
    }
}
