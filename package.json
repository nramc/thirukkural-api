{
    "name": "thirukkural-api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "echo \"Tests skipped. Everything is fine.\" && exit 1",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -b",
        "security:check": "npm audit --audit-level=high",
        "housekeeping": "npm run lint:fix && npm run format",
        "prepare:commit": "npm run housekeeping && npm run build",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run security:check && npm run test"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@vercel/functions": "3.9.5",
        "next": "16.3.3",
        "postcss": "^8.5.26",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@types/node": "24.13.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "@vercel/node": "^10.0.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.3",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": "24.20.0"
    }
}
