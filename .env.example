# Safe local-development defaults
LLM_PROVIDER=ollama
LLM_MODEL=mistral
# Comma-separated server-approved model IDs. Leave empty to allow the configured LLM_MODEL.
LLM_ALLOWED_MODELS=mistral
LLM_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

# Optional OpenRouter tuning. Reasoning tokens and unsorted load-balancing are the most
# common causes of slow OpenRouter responses in interactive/quiz-style chats.
# Set to "true" to re-enable extended reasoning on models that support it (slower, more thorough).
OPENROUTER_REASONING=false
# One of: throughput (default, fastest overall), latency (fastest first token), price (cheapest).
OPENROUTER_PROVIDER_SORT=throughput

# Public GA4 Measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

